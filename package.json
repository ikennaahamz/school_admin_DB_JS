{
  "name": "school-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:cloud": "cross-env DB_TARGET=cloud vitest run",
    "test:local": "cross-env DB_TARGET=local vitest run",
    "check-dsn": "tsx scripts/check-dsn.ts",
    "check:db": "tsx scripts/check-db.ts",
    "check:db:cloud": "cross-env DB_TARGET=cloud tsx scripts/check-db.ts",
    "check:db:local": "cross-env DB_TARGET=local tsx scripts/check-db.ts",
    "dsn-fingerprint": "tsx scripts/dsn-fingerprint.ts",
    "apply:migrations": "tsx scripts/apply-migrations.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
