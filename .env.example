# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------
# There are deliberately NO AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# entries here. A Next.js app has no use for them, and copying the
# Python project's credentials into this repo would be a real mistake.
# ---------------------------------------------------------------------

# The pooled Postgres connection string that the app itself uses.
# Neon -> Dashboard -> Connection Details -> "Pooled connection".
# Note the "-pooler" in the hostname and port 5432.
#
# On Windows, append ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The DIRECT (unpooled) Neon connection, used only by the migration
# scripts under scripts/. Migrations must not run on a pooled
# connection: DDL and advisory locks need a dedicated session.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require

# Secret used to sign the session cookie. There is no equivalent in the
# Python app -- Streamlit kept sessions server-side -- so this is new.
#
# Generate a fresh one:   openssl rand -base64 32
# Committing a real SESSION_SECRET would let anyone mint a valid
# session cookie, so this file stays a template.
SESSION_SECRET=

# Set to "local" to use a local PostgreSQL instance instead, which is
# handy for development without touching the cloud database.
# Same semantics as src/db.py's DB_TARGET.
# DB_TARGET=local
# LOCAL_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/school_validation